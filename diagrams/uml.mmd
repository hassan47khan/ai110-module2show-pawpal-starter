classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task_id) void
        +get_tasks() list~Task~
        +complete_task(task_id) Task
    }

    class Task {
        +int id
        +str description
        +int duration_minutes
        +str frequency
        +str priority
        +bool completed
        +str scheduled_time
        +date due_date
        +mark_complete() void
        +edit(description, duration_minutes, frequency, priority, scheduled_time) void
    }

    class Scheduler {
        +Owner owner
        +build_plan() DailyPlan
        +sort_by_time(tasks) list~Task~
        +filter_tasks(completed, pet_name) list~Task~
        +mark_task_complete(task) Task
        +detect_conflicts() list~str~
        -rank_tasks(tasks) list~Task~
        -explain(task, scheduled, remaining) str
    }

    class DailyPlan {
        +list~PlanEntry~ entries
        +list~tuple~ skipped
        +int total_minutes
        +add_entry(entry) void
        +summary() str
    }

    class PlanEntry {
        +Task task
        +str start_time
        +str reason
    }

    Owner "1" *-- "1..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : reads
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "0..*" PlanEntry : contains
    PlanEntry --> Task : refers to
